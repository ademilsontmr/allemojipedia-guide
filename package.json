{
  "name": "allemojipedia",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-redirects.mjs && node scripts/build-images.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=allemojipedia --branch=main",
    "data": "node scripts/build-data.mjs",
    "validate": "node scripts/validate-content.mjs && node scripts/validate-guides.mjs"
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@twemoji/svg": "^15.0.0",
    "emojibase-data": "^18.0.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
