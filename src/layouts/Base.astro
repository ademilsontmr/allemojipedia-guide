---
import "@/styles/global.css";
import { SITE, abs } from "@/lib/site";
import { categories, categoryUrl } from "@/lib/emoji";

interface Crumb { name: string; href?: string }
interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  ogType?: "website" | "article";
  noindex?: boolean;
  published?: string;
  ogImage?: string;
  /** First item is the page's unique primary keyword. */
  keywords?: string[];
  ogImageAlt?: string;
  modified?: string;
  section?: "emojis" | "categories" | "guides" | "blog" | "quiz" | "search";
  /** schema.org type for the page node added when `schema` is empty (e.g. "AboutPage"). */
  pageType?: string;
  /** Use the title as given, without the short-title brand suffix. */
  exactTitle?: boolean;
  /** Article section for article:section (emoji category, guide or blog category). */
  articleSection?: string;
}
const { title, description, path, crumbs = [], schema = [], ogType = "website", noindex = false, section, published, modified, ogImage = SITE.ogImage, ogImageAlt = ogImage === SITE.ogImage ? `${SITE.name}: ${SITE.tagline}` : undefined, keywords = [], pageType = "WebPage", exactTitle = false, articleSection } = Astro.props;
const canonical = abs(path);
// Long titles already fill the search snippet; only short ones get the brand suffix.
const fullTitle = exactTitle || path === "/" || [...title].length > 46 ? title : `${title} | ${SITE.name}`;
const trail = crumbs.length ? [{ name: "Home", href: "/" }, ...crumbs] : [];
const websiteRef = { "@id": abs("/#website") };
const pageId = `${canonical}#webpage`;
const crumbId = `${canonical}#breadcrumb`;
const image = { "@type": "ImageObject", url: abs(ogImage), width: 1200, height: 630 };
// Every node is connected: WebSite <- WebPage (with breadcrumb) <- main entity (Article, app, list...).
const PAGE_TYPES = ["WebPage", "CollectionPage", "AboutPage", "ContactPage", "ItemPage"];
const ENTITY_TYPES = ["Article", "BlogPosting", "NewsArticle", "WebApplication", "Blog"];
const nodes = schema.map((n) => ({ ...n }));
let page = nodes.find((n) => PAGE_TYPES.includes(n["@type"] as string));
if (!page && !noindex) { page = { "@type": pageType, name: title, description }; nodes.unshift(page); }
const entity = nodes.find((n) => ENTITY_TYPES.includes(n["@type"] as string));
if (page) {
  const id = (page["@id"] as string) ?? pageId;
  Object.assign(page, { "@id": id, url: page.url ?? canonical, name: page.name ?? title, description: page.description ?? description, inLanguage: "en", isPartOf: websiteRef,
    ...(trail.length ? { breadcrumb: { "@id": crumbId } } : {}), primaryImageOfPage: page.primaryImageOfPage ?? image,
    ...(published && !page.datePublished ? { datePublished: published } : {}), ...(modified && !page.dateModified ? { dateModified: modified } : {}),
    ...(entity?.["@id"] && !page.mainEntity ? { mainEntity: { "@id": entity["@id"] } } : {}) });
  for (const n of nodes) {
    if (n === page) continue;
    if (n.mainEntityOfPage === canonical) n.mainEntityOfPage = { "@id": id };
    if (n["@type"] === "FAQPage") Object.assign(n, { "@id": n["@id"] ?? `${canonical}#faq`, isPartOf: { "@id": id } });
    if (ENTITY_TYPES.includes(n["@type"] as string) && (!n.isPartOf || (n.isPartOf as { "@id"?: string })["@id"] === websiteRef["@id"])) n.isPartOf = { "@id": id };
  }
}
const graph: Record<string, unknown>[] = [
  { "@type": "WebSite", "@id": abs("/#website"), url: abs("/"), name: SITE.name, description: SITE.description, inLanguage: "en", publisher: { "@id": abs("/#org") } },
  { "@type": "Organization", "@id": abs("/#org"), name: SITE.name, url: abs("/"), email: SITE.email,
    logo: { "@type": "ImageObject", url: abs("/icon-512.png"), width: 512, height: 512 },
    contactPoint: { "@type": "ContactPoint", contactType: "customer support", email: SITE.email, url: abs("/contact/"), availableLanguage: "en" } },
  ...nodes,
];
if (trail.length)
  graph.push({ "@type": "BreadcrumbList", "@id": crumbId, itemListElement: trail.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: abs(c.href ?? path) })) });
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(/</g, "\\u003c");
const nav = [
  { href: "/emojis/", label: "Emojis", key: "emojis" },
  { href: "/categories/", label: "Categories", key: "categories" },
  { href: "/guides/", label: "Guides", key: "guides" },
  { href: "/blog/", label: "Blog", key: "blog" },
  { href: "/flag-emoji-quiz/", label: "Flag quiz", key: "quiz" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" hreflang="en" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {ogType === "article" && <meta property="article:author" content={abs("/about/")} />}
    {ogType === "article" && articleSection && <meta property="article:section" content={articleSection} />}
    {ogType === "article" && <meta name="author" content={SITE.team} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:type" content="image/png" />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} guides`} href="/guides/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/blog/rss.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}><img src="/logo-64.png" alt="" width="32" height="32" decoding="async" /><span>{SITE.name}</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={section === n.key ? "page" : undefined}>{n.label}</a>)}
          <a class="search-link" href="/search/" aria-label="Search emojis" aria-current={section === "search" ? "page" : undefined}>Search</a>
        </nav>
      </div>
    </header>
    {trail.length > 0 && (
      <nav class="crumbs wrap" aria-label="Breadcrumb">
        <ol>{trail.map((c, i) => <li>{c.href && i < trail.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}</ol>
      </nav>
    )}
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="fh">Categories</p>
            <ul>{categories.map((c) => <li><a href={categoryUrl(c.slug)}><span class="em" aria-hidden="true">{c.icon}</span> {c.name}</a></li>)}</ul>
          </div>
          <div>
            <p class="fh">Explore</p>
            <ul>
              <li><a href="/emojis/">All emoji meanings</a></li>
              <li><a href="/what-does-this-emoji-mean/">What does this emoji mean?</a></li>
              <li><a href="/categories/">Browse by category</a></li>
              <li><a href="/guides/">Guides</a></li>
              <li><a href="/blog/">Emoji news</a></li>
              <li><a href="/emoji-copy-and-paste/">Emoji copy and paste</a></li>
              <li><a href="/text-symbols/">Text symbols</a></li>
              <li><a href="/kaomoji/">Kaomoji</a></li>
              <li><a href="/flag-emoji-quiz/">Flag emoji quiz</a></li>
              <li><a href="/search/">Search</a></li>
            </ul>
          </div>
          <div>
            <p class="fh">About</p>
            <ul>
              <li><a href="/about/">About us</a></li>
              <li><a href="/editorial-policy/">Editorial policy</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy policy</a></li>
            </ul>
          </div>
        </div>
        <p class="legal">© {new Date().getFullYear()} {SITE.name}. Emoji names and code points follow the Unicode Standard and CLDR. Emoji designs belong to their respective platform owners; this site displays your device's own emoji font. Emoji images on meaning pages: Twemoji, CC-BY 4.0. {SITE.name} is independent and not affiliated with the Unicode Consortium or Emojipedia.</p>
      </div>
    </footer>
    <div id="toast" class="sr-only" role="status" aria-live="polite"></div>
    <script is:inline>
      document.addEventListener("click", function (e) {
        var el = e.target.closest("[data-copy]");
        if (!el) return;
        var text = el.getAttribute("data-copy");
        var done = function () {
          el.classList.add("copied");
          document.getElementById("toast").textContent = "Copied " + text;
          var label = el.querySelector("[data-copy-label]"), old = label && label.textContent;
          if (label) label.textContent = "Copied!";
          setTimeout(function () { el.classList.remove("copied"); if (label) label.textContent = old; }, 1200);
        };
        var legacy = function () {
          var t = document.createElement("textarea"); t.value = text; t.setAttribute("readonly", ""); t.style.position = "fixed"; t.style.opacity = "0";
          document.body.appendChild(t); t.select(); try { if (document.execCommand("copy")) done(); } catch (x) {} t.remove();
        };
        // Some browsers and embedded views refuse the async Clipboard API; fall back to execCommand.
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, legacy);
        else legacy();
      });
    </script>
    <script is:inline define:vars={{ client: SITE.adsenseClient }}>
      // Ads load after the page is interactive so they never block content.
      (function () {
        var loaded = false;
        function load() {
          if (loaded) return; loaded = true;
          var s = document.createElement("script"); s.async = true; s.crossOrigin = "anonymous";
          s.src = "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + client;
          document.head.appendChild(s);
        }
        ["scroll", "pointerdown", "keydown", "touchstart"].forEach(function (ev) { addEventListener(ev, load, { once: true, passive: true }); });
        addEventListener("load", function () { setTimeout(load, 4000); });
      })();
    </script>
  </body>
</html>
