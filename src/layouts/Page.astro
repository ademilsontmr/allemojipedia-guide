---
import Base from "@/layouts/Base.astro";
import { SITE, fmtDate } from "@/lib/site";
interface Props { title: string; description: string; path: string; heading: string; lead?: string; noindex?: boolean }
const { title, description, path, heading, lead, noindex } = Astro.props;
---
<Base title={title} description={description} path={path} noindex={noindex} crumbs={noindex ? [] : [{ name: heading }]}>
  <article class="wrap">
    <div class="prose article" style="margin-inline:auto">
      <header class="article-hero">
        <h1>{heading}</h1>
        {lead && <p class="lead">{lead}</p>}
      </header>
      <slot />
      {!noindex && <p class="byline">Last updated <time datetime={SITE.launched}>{fmtDate(SITE.launched)}</time></p>}
    </div>
  </article>
</Base>
